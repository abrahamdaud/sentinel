#!/usr/bin/env bash
# SENTINEL launcher for Termux / Linux
# This does not contact any external server; it simply invokes the single PowerShell implementation.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="$SCRIPT_DIR/sentinel.ps1"

if ! command -v pwsh >/dev/null 2>&1; then
    echo "[SENTINEL] PowerShell Core (pwsh) is required. In Termux, install it with: pkg install powershell"
    exit 1
fi

exec pwsh -NoProfile -File "$SCRIPT_PATH" "$@"
