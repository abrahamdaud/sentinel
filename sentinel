#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
APP_NAME="SENTINEL"

usage() {
  cat <<'EOF'
SENTINEL

Usage:
  ./sentinel install
  ./sentinel start
  ./sentinel stealth
  ./sentinel tui
  ./sentinel scan
  ./sentinel status
  ./sentinel stop
  ./sentinel help

Notes:
  - Offline and local-only.
  - Silent mode keeps output minimal.
  - TUI refreshes approximately 60 FPS.
EOF
}

run_runtime() {
  local cmd="${1:-help}"
  shift || true

  if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$SCRIPT_DIR/sentinel.ps1" "$cmd" "$@"
  fi

  if [ -f "$SCRIPT_DIR/sentinel-native.sh" ]; then
    exec bash "$SCRIPT_DIR/sentinel-native.sh" "$cmd" "$@"
  fi

  echo "[SENTINEL] No supported runtime found. Install PowerShell Core or use bash." >&2
  exit 1
}

case "${1:-help}" in
  install)
    if command -v pwsh >/dev/null 2>&1; then
      pwsh -NoProfile -File "$SCRIPT_DIR/sentinel.ps1" install
    elif [ -f "$SCRIPT_DIR/install.sh" ]; then
      bash "$SCRIPT_DIR/install.sh"
    else
      bash "$SCRIPT_DIR/sentinel-native.sh" install
    fi
    ;;
  start|scan|status|stop|stealth|tui|help|-h|--help)
    run_runtime "$@"
    ;;
  *)
    usage
    ;;
 esac
